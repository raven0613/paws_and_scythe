# overrides 取代卡池欄位後再填入說明，例如效益調整後的 value。
static func description(id: String, overrides: Dictionary = {}) -> String:
	var fields: Dictionary = CARDS[id].duplicate()
	fields.merge(fields.get("rules", {}))
	fields.merge(overrides, true)
	for key in fields:
		if fields[key] is float and is_equal_approx(fields[key], round(fields[key])):
			fields[key] = int(fields[key])
	return CARDS[id].text.format(fields)

static func art(id: String) -> String:
	return ART_PATHS[CARDS.keys().find(id) % ART_PATHS.size()]

static func valid_selection(ids: Array) -> bool:
	if ids.size() > MAX_EQUIPPED:
		return false
	var seen := {}
	for id in ids:
		if not CARDS.has(id) or seen.has(id):
			return false
		seen[id] = true
	return true
