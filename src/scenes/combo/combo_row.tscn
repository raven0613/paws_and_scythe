[ext_resource type="Texture2D" path="res://src/assets/combo_frame_01.png" id="2_frame"]

[node name="combo_row" type="Control"]
editor_description = "一列牌型與分數。框形使用 NinePatchRect，文字變長時自動加寬；Frame Color、Text Color、Score Color、Shadow Color 可分別換色。"
texture_filter = 1
layout_mode = 0
offset_right = 121.0
offset_bottom = 32.0
mouse_filter = 2
script = ExtResource("1_script")

[node name="spacing" type="Control" parent="."]
layout_mode = 0
mouse_filter = 2

[node name="idle" type="Node2D" parent="spacing"]

[node name="visual" type="Control" parent="spacing/idle"]
layout_mode = 0
mouse_filter = 2

[node name="shadow" type="NinePatchRect" parent="spacing/idle/visual"]
layout_mode = 0
mouse_filter = 2
